# Postgres (Docker local; Neon ou outro Postgres na Cloudflare)
DATABASE_URL="postgresql://habitos:habitos@localhost:5432/habitos?schema=public"

# Assina o cookie e autentica o Postman (x-api-key). Não é senha de usuário.
# Local: pode copiar este valor. Produção: gere outro (openssl rand -base64 48).
AUTH_SECRET="gere-uma-string-longa-aleatoria"
